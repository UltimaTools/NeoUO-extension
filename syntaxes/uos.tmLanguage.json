{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "UOSteam",
    "patterns": [
        {
            "include": "#keywords"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.uos",
                    "match": "\\b(if|elseif|else|endif|while|endwhile|for|to|in|endfor|return)\\b"
                },
                {
                    "name": "keyword.control.uos",
                    "match": "\\b(pause|break|continue|stop|replay|not|and|or)\\b"
                },
                {
                    "name": "keyword.operator.comparison.uos",
                    "match": "\\b(==|!=|>=|<=|<|>|\\[|\\])\\b"
                },
                {
                    "name": "keyword.operator.at.uos",
                    "match": "@"
                },
                {
                    "name": "support.function.uos",
                    "match": "\\b(addfriend|allymsg|amount|attack|autocolorpick|autoloot|autotargetobject|bandage|bandageself|bigheal|buffexists|buy|cancelautotarget|cancelprompt|canceltarget|cast|chatmsg|chivalryheal|clearbuy|clearhands|clearignorelist|clearjournal|clearlist|clearsell|cleartargetqueue|clearusequeue|clickobject|clickscreen|closegump|cold|color|contents|contextmenu|counter|counttype|counttypeground|createlist|createtimer|criminal|dead|dex|diffhits|diffweight|direction|directionname|distance|dress|dressconfig|durability|emotemsg|energy|equipitem|equipwand|feed|findalias|findlayer|findobject|findtype|findwand|fire|fly|flying|followers|getenemy|getfriend|gold|graphic|gray|guildbutton|guildmsg|gumpexists|headmsg|helpbutton|hidden|hits|hotkeys|ignoreobject|info|infriendlist|ingump|injournal|inlist|innocent|inparty|inrange|inregion|int|land|list|listexists|location|logoutbutton|luck|mana|mapuo|maxfollowers|maxhits|maxmana|maxstam|maxweight|messagebox|miniheal|mounted|moveitem|moveitemoffset|movetype|movetypeoffset|msg|murderer|name|namespace|organizer|organizing|paralyzed|partymsg|pathfindto|physical|ping|playmacro|playsound|poison|poisoned|poplist|promptalias|promptmsg|property|pushlist|questsbutton|removefriend|removelist|removetimer|rename|replygump|restock|restocking|resync|run|script|sell|serial|setability|setalias|setskill|settimer|shownames|skill|skillbase|skillstate|skillvalue|snapshot|stam|str|sysmsg|target|targetexists|targetground|targetresource|targettile|targettileoffset|targettilerelative|targettype|timer|timerexists|timermsg|toggleautoloot|togglehands|togglemounted|togglescavenger|turn|undress|uniquejournal|unsetalias|useobject|useonce|useskill|usetype|virtue|waitforcontents|waitforcontext|waitforgump|waitforjournal|waitforprompt|waitforproperties|waitfortarget|waitingfortarget|walk|war|warmode|weight|where|whispermsg|x|y|yellmsg|yellowhits|z)[!]?\\b"
                },
                {
                    "name": "support.constant.uos",
                    "match": "\\b(any|backpack|bank|enemy|friend|ground|last|lasttarget|lastobject|lefthand|mount|righthand|self)\\b"
                },
                {
                    "name": "comment.line.uos",
                    "match": "//.*"
                },
                {
                    "name": "constant.language.uos",
                    "match": "\\b(?i:(true|false))\\b"
                },
                {
                    "name": "constant.numeric.hexadecimal.uos",
                    "match": "\\b0(x|X)[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.uos",
                    "match": "\\b[0-9]{1,16}\\b"
                },
                {
                    "name": "string.quoted.single.uos",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "support.constant.uos",
                            "match": "\\b(any|backpack|bank|enemy|friend|ground|last|lasttarget|lastobject|lefthand|mount|righthand|self)\\b"
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.uos",
                    "begin": "\"",
                    "end": "\""
                }
            ]
        }
    },
    "scopeName": "source.uos"
}
